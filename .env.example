# Sao chép thành .env.local khi chạy trên máy; trên Vercel đặt trong Settings → Environment Variables.
# 复制为 .env.local 后填入实际值；Vercel 上在 Settings → Environment Variables 设置。
# KHÔNG commit khóa thật lên Git. 切勿把真实密钥提交到 Git。

# ─── AI luận giải · AI 解读（/api/interpret, /api/heming）───
# Claude (mặc định): khóa lấy ở Claude Console → API Keys, có dạng sk-ant-api03-…
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic          # hoặc deepseek
# AI_MODEL=claude-sonnet-5-5     # rẻ hơn: claude-haiku-5-5
# AI_MAX_TOKENS=4000

# DeepSeek (tùy chọn): AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-flash

# Giới hạn lượt luận theo IP · 按 IP 限流
# AI_RATE_LIMIT_PER_HOUR=20
# AI_RATE_LIMIT_PER_DAY=60

# ─── Địa chỉ trang · 站点 ───
# Để trống: trên Vercel tự dùng địa chỉ production; trên máy dùng http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
